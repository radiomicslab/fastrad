         md.append(f"- **Paired $\\Delta\\text{{ICC}}$ (fastrad - PyRadiomics) [95% CI]**: **{f_mean - p_mean:+.4f}** [{diff_ci[0]:.4f}, {diff_ci[1]:.4f}]\n")
         
-        from scipy.stats import wilcoxon
